# Claude
ANTHROPIC_API_KEY=sk-ant-...

# Local infra (docker compose up -d)
DATABASE_URL=postgresql+asyncpg://frontdesk:frontdesk@localhost:5434/frontdesk
REDIS_URL=redis://localhost:6380

# Twilio (leave blank for Phase 1 - sends are stubbed and logged)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true
PUBLIC_BASE_URL=http://localhost:8000

# Google Calendar - path to the service account JSON key.
# Leave blank for Phase 1/2 local work: bookings use an in-memory stub.
GOOGLE_CREDENTIALS_PATH=
# Or the whole service-account JSON inline, for a host with no disk.
# Takes precedence over the path when both are set.
GOOGLE_CREDENTIALS_JSON=


# Behaviour
AI_ENABLED=true
LOG_LEVEL=INFO

# Only for a *transaction mode* pooler (Supabase port 6543, PgBouncer).
# Session mode and direct connections do not need it. See docs/deploy.md.
DB_DISABLE_PREPARED_STATEMENTS=false
